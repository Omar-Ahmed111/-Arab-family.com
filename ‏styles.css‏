body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-color: #f0f0f0;
    color: #333;
    margin: 0;
    padding: 0;
}

header {
    background-color: #003366;
    color: #fff;
    padding: 20px;
    text-align: center;
}

nav ul {
    list-style: none;
    padding: 0;
    display: flex;
    justify-content: center;
    background-color: #ffd700;
}

nav ul li {
    margin: 0 10px;
}

nav ul li a {
    text-decoration: none;
    color: #003366;
    padding: 10px 20px;
}

nav ul li a:hover {
    background-color: #003366;
    color: #fff;
}

section {
    padding: 20px;
    margin: 20px auto;
    background-color: #fff;
    max-width: 800px;
    border-radius: 8px;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
}

#welcome {
    text-align: center;
    background-color: #edf7f9;
    padding: 40px;
    border-radius: 8px;
    margin: 20px auto;
    max-width: 800px;
}

#welcome img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin-top: 20px;
}

footer {
    text-align: center;
    padding: 10px;
    background-color: #003366;
    color: #fff;
    position: fixed;
    bottom: 0;
    width: 100%;
}

h2 {
    margin-top: 0;
}

button {
    background-color: #ffd700;
    color: #003366;
    border: none;
    padding: 10px 20px;
    cursor: pointer;
    border-radius: 5px;
    transition: background-color 0.3s;
}

button:hover {
    background-color: #f29802;
}